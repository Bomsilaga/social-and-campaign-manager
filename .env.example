# SOCIAL AND CAMPAIGN MANAGER — server-side configuration only
# Add through Vercel > Project > Settings > Environment Variables.
# NEVER paste real keys into GitHub, browser devtools, or ChatGPT.
EDITOR_ACCESS_TOKEN=

# Leave false until you explicitly approve billable model calls.
ALLOW_PAID_GENERATION=false

# AI script creation, image generation and second-model review
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Voice generation: choose a voice ID you have permission to use
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Licensed stock footage search
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube public discovery — enables /api/discover but NOT YouTube upload
YOUTUBE_API_KEY=

# Supabase draft manifest storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Or use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
# Must run supabase/schema.sql before using cloud project vault.

# Future OAuth/platform publishing setup — storing these does NOT enable publishing
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional future render queue
RENDER_WORKER_URL=
RENDER_WORKER_SHARED_SECRET=

# Secure Facebook Pages OAuth (Campaigner 2)
# Use META_APP_ID from App Settings -> Basic; use META_APP_SECRET only server-side.
# Generate META_TOKEN_ENCRYPTION_KEY using 32 random bytes, encoded in base64.
META_TOKEN_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://social-and-campaign-manager.vercel.app
# Exact callback: https://social-and-campaign-manager.vercel.app/api/meta/callback

# TikTok Sandbox Login Kit — use Sandbox credentials only
# IMPORTANT: rotate any client secret previously disclosed in chat.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Base64 encoded random 32 bytes; keep it stable after connection.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Callback: https://social-and-campaign-manager.vercel.app/api/tiktok/callback
