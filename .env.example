# Set these only in Vercel Project > Settings > Environment Variables.
# Never commit real keys or store credentials in frontend source code.
EDITOR_ACCESS_TOKEN=
PEXELS_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Must explicitly be true AND OPENAI_API_KEY configured for billable generation:
ALLOW_PAID_GENERATION=false
# Future integrations, not yet wired in v0.3:
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
